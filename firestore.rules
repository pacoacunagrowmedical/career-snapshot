rules_version = '2';

// Si cambias el dominio permitido (VITE_ALLOWED_DOMAIN), cámbialo también aquí.
service cloud.firestore {
  match /databases/{database}/documents {

    function esEquipo() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('.*@growmedical[.]org$');
    }

    function texto(v, max) {
      return v is string && v.size() <= max;
    }

    // Validación básica de una solicitud nueva (el formulario hace la validación detallada).
    function solicitudValida(d) {
      return d.keys().hasOnly([
          'puestoId', 'puestoNombre', 'fuente', 'fuenteDetalle', 'nombre', 'fechaNacimiento', 'pais',
          'direccion', 'email', 'telefono', 'moneda', 'sueldoEsperado', 'empleos', 'freelance',
          'universidad', 'fortalezas', 'debilidades', 'objetivos', 'avisoPrivacidad', 'posibleBot', 'creado'])
        && texto(d.nombre, 200) && d.nombre.size() > 1
        && texto(d.email, 200) && d.email.matches('.+@.+[.].+')
        && texto(d.telefono, 30)
        && texto(d.puestoId, 100)
        && d.sueldoEsperado is number
        && d.empleos is list && d.empleos.size() <= 25
        && d.freelance is list && d.freelance.size() <= 15
        && d.universidad is map
        && texto(d.fortalezas, 5000) && texto(d.debilidades, 5000) && texto(d.objetivos, 5000)
        && d.avisoPrivacidad == true
        && d.creado == request.time;
    }

    // Candidatos: cualquiera puede ENVIAR una solicitud; solo el equipo puede leer o borrar.
    match /candidatos/{id} {
      // El equipo además puede crear registros directamente (importación desde el formulario anterior).
      allow create: if solicitudValida(request.resource.data) || esEquipo();
      allow read, delete: if esEquipo();
      // El equipo solo puede cambiar el seguimiento (etapa, etiquetas, contador de notas), nunca las respuestas del candidato.
      allow update: if esEquipo()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['etapa', 'etiquetas', 'numNotas', 'orden']);

      // Notas y registro de cambios de etapa.
      match /notas/{nota} {
        allow read: if esEquipo();
        allow create: if esEquipo()
          && request.resource.data.keys().hasOnly(['tipo', 'texto', 'autorEmail', 'autorNombre', 'creado', 'editado'])
          && request.resource.data.tipo in ['nota', 'cambio']
          && texto(request.resource.data.texto, 10000)
          && request.resource.data.autorEmail == request.auth.token.email
          && request.resource.data.creado == request.time
          && request.resource.data.editado == null;
        // Solo quien escribió una nota puede editarla o borrarla. Los registros de cambio de etapa no se editan.
        allow update: if esEquipo()
          && resource.data.tipo == 'nota'
          && resource.data.autorEmail == request.auth.token.email
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['texto', 'editado'])
          && texto(request.resource.data.texto, 10000);
        // Al eliminar al candidato se eliminan todas sus notas en el mismo lote.
        allow delete: if esEquipo() && (
          (resource.data.tipo == 'nota' && resource.data.autorEmail == request.auth.token.email)
          || !existsAfter(/databases/$(database)/documents/candidatos/$(id)));
      }
    }

    // Etiquetas que define el equipo.
    match /etiquetas/{id} {
      allow read, write: if esEquipo();
    }

    // Puestos: el nombre es público (el formulario lo necesita); editar es del equipo.
    match /puestos/{id} {
      allow read: if true;
      allow write: if esEquipo();
    }

    // Sueldo ofrecido por puesto: privado.
    match /puestosPrivado/{id} {
      allow read, write: if esEquipo();
    }
  }
}
