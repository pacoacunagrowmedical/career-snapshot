# Configuración del proyecto de Firebase (Consola → Configuración del proyecto → Tus apps → Web).
# Si VITE_FIREBASE_API_KEY está vacío, la app corre en "modo demo" con datos de ejemplo guardados en el navegador.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Clave de sitio de reCAPTCHA Enterprise para App Check (protección invisible contra bots). Opcional.
VITE_RECAPTCHA_SITE_KEY=

# Solo las cuentas de Google de este dominio pueden entrar al panel.
VITE_ALLOWED_DOMAIN=growmedical.org
